# =============================================================================
# Nashordaq Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# All variables are prefixed with NASHORDAQ_ to avoid collisions.
# =============================================================================

# -- Riot API -----------------------------------------------------------------
# Required. Get your key at https://developer.riotgames.com/
NASHORDAQ_RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Account API routing (by continent). Options:
#   https://americas.api.riotgames.com
#   https://europe.api.riotgames.com
#   https://asia.api.riotgames.com
NASHORDAQ_RIOT_API_BASE_URL=https://europe.api.riotgames.com

# Platform-specific API routing (by server). Options:
#   https://euw1.api.riotgames.com   (EU West)
#   https://eun1.api.riotgames.com   (EU Nordic & East)
#   https://na1.api.riotgames.com    (North America)
#   https://kr.api.riotgames.com     (Korea)
#   See: https://developer.riotgames.com/docs/lol#routing-values
NASHORDAQ_RIOT_API_REGION_URL=https://euw1.api.riotgames.com

# -- Database -----------------------------------------------------------------
# SQLite database path (relative to the backend/ directory).
# No external database server required.
NASHORDAQ_DATABASE_URL=sqlite+aiosqlite:///data/nashordaq.db

# -- Networking ---------------------------------------------------------------
# Comma-separated list of allowed CORS origins (your frontend URL).
NASHORDAQ_CORS_ORIGINS=https://nashordaq.yourdomain.com

# The public domain Nashordaq is served on.
NASHORDAQ_DOMAIN=nashordaq.yourdomain.com

# -- Authentication -----------------------------------------------------------
# HTTP header injected by Pangolin (or other IAP) containing the
# authenticated user's identity. Pangolin sends Remote-User by default.
NASHORDAQ_AUTH_HEADER=Remote-User

# Optional spectator-only remote user. When the authenticated username matches
# this value, the account can view the app but cannot onboard or trade.
NASHORDAQ_SPECTATOR_REMOTE_USER=admin@yourdomain.com

# -- Pangolin / Newt Tunnel ---------------------------------------------------
# Pangolin endpoint URL (e.g. https://pangolin.yourdomain.com)
PANGOLIN_ENDPOINT=https://pangolin.yourdomain.com

# Newt tunnel credentials (from Pangolin dashboard).
NEWT_ID=
NEWT_SECRET=

# -- Economy ------------------------------------------------------------------
# Starting virtual currency balance for new users.
NASHORDAQ_STARTING_BALANCE=1000.0

# -- Poro ---------------------------------------------------------------------
# Optional local-development override. Leave unset in normal environments to use
# the default minute-based poro schedule.
# NASHORDAQ_PORO_MIN_INTERVAL_SECONDS_OVERRIDE=10
# NASHORDAQ_PORO_MAX_INTERVAL_SECONDS_OVERRIDE=10
