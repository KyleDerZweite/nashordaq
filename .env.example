# =============================================================================
# Nashordaq Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# All variables are prefixed with NASHORDAQ_ to avoid collisions.
# =============================================================================

# -- Demo Mode ----------------------------------------------------------------
# Set to true to run Nashordaq as a public demo without Riot API keys or
# proxy auth. Market data is seeded from demo/demo_seed.json and prices are
# simulated. Sessions are cookie-based and expire after 24 hours.
# NASHORDAQ_DEMO_MODE_ENABLED=true

# -- Riot API -----------------------------------------------------------------
# Required (unless demo mode is enabled). Get your key at https://developer.riotgames.com/
NASHORDAQ_RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Account API routing (by continent). Options:
#   https://americas.api.riotgames.com
#   https://europe.api.riotgames.com
#   https://asia.api.riotgames.com
NASHORDAQ_RIOT_API_BASE_URL=https://europe.api.riotgames.com

# Platform-specific API routing (by server). Options:
#   https://euw1.api.riotgames.com   (EU West)
#   https://eun1.api.riotgames.com   (EU Nordic & East)
#   https://na1.api.riotgames.com    (North America)
#   https://kr.api.riotgames.com     (Korea)
#   See: https://developer.riotgames.com/docs/lol#routing-values
NASHORDAQ_RIOT_API_REGION_URL=https://euw1.api.riotgames.com

# -- Database -----------------------------------------------------------------
# SQLite database path (relative to the backend/ directory).
# No external database server required.
NASHORDAQ_DATABASE_URL=sqlite+aiosqlite:///data/nashordaq.db

# -- Networking ---------------------------------------------------------------
# Comma-separated list of allowed CORS origins (your frontend URL).
NASHORDAQ_CORS_ORIGINS=https://nashordaq.yourdomain.com

# The public domain Nashordaq is served on.
NASHORDAQ_DOMAIN=nashordaq.yourdomain.com

# -- Authentication -----------------------------------------------------------
# Headers injected by your reverse proxy (Pangolin, Zitadel, etc.).
# Remote-Email is the primary identity key; Remote-User is a legacy fallback.
NASHORDAQ_REMOTE_EMAIL_HEADER=Remote-Email
NASHORDAQ_REMOTE_NAME_HEADER=Remote-Name
NASHORDAQ_AUTH_HEADER=Remote-User

# Optional admin user list. When the authenticated username matches one of
# these values, the account gets the read-only Admin dashboard and cannot trade.
NASHORDAQ_ADMIN_REMOTE_USERS=admin@yourdomain.com

# IMPORTANT: The backend trusts the Remote-* headers above for identity.
# Anything that can reach the backend port directly (another container,
# a misconfigured port publish, LAN access) can impersonate any user or
# admin by sending those headers. Strongly recommended for every deployment:
# reject auth requests whose source IP is not a trusted proxy/tunnel.
# Set the CIDRs to your container network (find it with:
#   podman network inspect <network> | grep -i subnet).
NASHORDAQ_ENFORCE_TRUSTED_PROXY=true
NASHORDAQ_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,10.89.0.0/24

# -- Pangolin / Newt Tunnel ---------------------------------------------------
# Pangolin endpoint URL (e.g. https://pangolin.yourdomain.com)
PANGOLIN_ENDPOINT=https://pangolin.yourdomain.com

# Newt tunnel credentials (from Pangolin dashboard).
NEWT_ID=
NEWT_SECRET=

# -- Economy ------------------------------------------------------------------
# Starting virtual currency balance for new users.
NASHORDAQ_STARTING_BALANCE=1000.0

# -- Gamba --------------------------------------------------------------------
# Set to false to disable the gamba feature entirely (API returns 404,
# settlement is skipped, and the frontend hides gamba UI).
# Recommended: set this to false for any public-facing, compliance-oriented,
# or production-style deployment.
NASHORDAQ_GAMBA_ENABLED=true

# -- Poro ---------------------------------------------------------------------
# Optional local-development override. Leave unset in normal environments to use
# the default minute-based poro schedule.
# NASHORDAQ_PORO_MIN_INTERVAL_SECONDS_OVERRIDE=10
# NASHORDAQ_PORO_MAX_INTERVAL_SECONDS_OVERRIDE=10
