# =============================================================================
# Nashordaq Demo Deployment
# =============================================================================
# Copy this file to .env in your demo deployment directory.
# Uses the same podman-compose.yaml as production — just point it at this env.
# Set the Pangolin resource to "auth disabled" so visitors can access without SSO.
# =============================================================================

# -- Demo Mode ----------------------------------------------------------------
NASHORDAQ_DEMO_MODE_ENABLED=true

# -- Riot API -----------------------------------------------------------------
# Not required in demo mode. Leave empty.
NASHORDAQ_RIOT_API_KEY=

NASHORDAQ_RIOT_API_BASE_URL=https://europe.api.riotgames.com
NASHORDAQ_RIOT_API_REGION_URL=https://euw1.api.riotgames.com

# -- Database -----------------------------------------------------------------
NASHORDAQ_DATABASE_URL=sqlite+aiosqlite:///data/nashordaq.db

# -- Networking ---------------------------------------------------------------
NASHORDAQ_CORS_ORIGINS=https://demo.nashordaq.yourdomain.com
NASHORDAQ_DOMAIN=demo.nashordaq.yourdomain.com

# -- Authentication -----------------------------------------------------------
# These headers won't be present since Pangolin auth is disabled for this
# resource, but keep the defaults so the config is valid.
NASHORDAQ_REMOTE_EMAIL_HEADER=Remote-Email
NASHORDAQ_REMOTE_NAME_HEADER=Remote-Name
NASHORDAQ_AUTH_HEADER=Remote-User
NASHORDAQ_ADMIN_REMOTE_USERS=

# -- Pangolin / Newt Tunnel ---------------------------------------------------
PANGOLIN_ENDPOINT=https://pangolin.yourdomain.com
NEWT_ID=
NEWT_SECRET=

# -- Economy ------------------------------------------------------------------
NASHORDAQ_STARTING_BALANCE=1000.0

# Public demo deployments should keep the private-only gamba feature disabled.
NASHORDAQ_GAMBA_ENABLED=false
