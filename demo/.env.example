# Copy to the root .env of a separate demo checkout with an empty data/ directory.
# Copy to .env and restrict access with chmod 600 .env.
# Set PUBLIC_URL to the exact browser-visible origin before account setup.
NASHORDAQ_PUBLIC_URL=http://localhost:8081

# Only the frontend HTTP entry point is published.
# Use 0.0.0.0 for LAN access or 127.0.0.1 behind a local reverse proxy.
NASHORDAQ_HTTP_BIND=0.0.0.0
NASHORDAQ_HTTP_PORT=8081

# Same-origin traffic needs no extra CORS origins. Separate origins are optional.
NASHORDAQ_CORS_ORIGINS=

# Optional for local accounts and administration. Required for live Riot data.
# Obtain a key from https://developer.riotgames.com/ and store it only in .env.
NASHORDAQ_RIOT_API_KEY=
NASHORDAQ_RIOT_API_BASE_URL=https://europe.api.riotgames.com
NASHORDAQ_RIOT_API_REGION_URL=https://euw1.api.riotgames.com

# Compose fixes SQLite to /app/data/nashordaq.db, persisted in host ./data.
# For local development only, optionally override the backend-relative path:
# NASHORDAQ_DATABASE_URL=sqlite+aiosqlite:///data/nashordaq.db
NASHORDAQ_STARTING_BALANCE=1000.0

# Explicit demo mode loads ./demo/demo_seed.json automatically. Use a fresh,
# separate installation directory.
NASHORDAQ_DEMO_MODE_ENABLED=true

# Optional private-use feature. Set true only to explicitly enable Gamba.
NASHORDAQ_GAMBA_ENABLED=false

# Optional local-development poro schedule overrides.
# NASHORDAQ_PORO_MIN_INTERVAL_SECONDS_OVERRIDE=10
# NASHORDAQ_PORO_MAX_INTERVAL_SECONDS_OVERRIDE=10
